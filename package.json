{
  "name": "sonshine-roofing-next",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "predev": "npm run prebuild:codex",
    "dev": "next dev",
    "prebuild": "npm run verify:special-offer-indexing && npm run verify:build-only-revalidation && npm run verify:project-pipeline && npm run verify:video-pipeline && node scripts/prebuild.mjs",
    "build": "next build",
    "prebuild:codex": "node scripts/prebuild.mjs",
    "build:codex": "NODE_OPTIONS=\"--require ./scripts/codex-fetch-proxy.cjs $NODE_OPTIONS\" next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run lint",
    "verify:tailwind-utilities": "node ./scripts/verify-tailwind-utilities.mjs",
    "verify:directus-html": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/verify-directus-html.mjs",
    "verify:faq-html": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/verify-faq-html.mjs",
    "verify:person-html": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/verify-person-html.mjs",
    "verify:sponsor-html": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/verify-sponsor-html.mjs",
    "verify:directus-fetch-policy": "node ./scripts/verify-directus-fetch-policy.mjs",
    "verify:glossary-html": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/verify-glossary-html.mjs",
    "verify:glossary-policy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/verify-glossary-policy.mjs",
    "verify:person-seo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/verify-person-seo.mjs",
    "verify:json-ld": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/verify-json-ld-serialization.mjs",
    "verify:security-input-handling": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/verify-security-input-handling.mjs",
    "verify:wordpress-html": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/verify-wordpress-html.mjs",
    "verify:special-offer-indexing": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/verify-special-offer-indexing.mjs",
    "verify:build-only-revalidation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/verify-build-only-revalidation.mjs",
    "verify:request-body-limits": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/verify-request-body-limits.mjs",
    "migrate:persons:dry-run": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/migrate-wordpress-persons.mjs --dry-run",
    "migrate:persons:apply": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/migrate-wordpress-persons.mjs --apply",
    "verify:project-pipeline": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/verify-project-pipeline.mjs",
    "verify:archive-controls": "node scripts/verify-archive-controls.mjs",
    "verify:video-playback": "node scripts/verify-video-playback.mjs",
    "verify:video-pipeline": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/verify-video-pipeline.mjs",
    "verify:video-migration": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/verify-video-migration.mjs",
    "migrate:videos:dry-run": "node scripts/migrate-wordpress-videos.mjs --dry-run",
    "migrate:videos:apply": "node scripts/migrate-wordpress-videos.mjs --apply"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "fast-glob": "^3.3.2",
    "framer-motion": "^12.43.0",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^0.577.0",
    "next": "~16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.7",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "~16.3.4",
    "@types/node": "20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "autoprefixer": "10.5.5",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "14.0.0",
    "jsdom": "^30.0.1",
    "postcss": "8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "3.4.19",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@9": {
      "brace-expansion": "2.1.4"
    },
    "@eslint/eslintrc": {
      "js-yaml": "4.3.2"
    },
    "sharp@0.34.5": "0.35.3",
    "postcss": "8.5.28"
  }
}
